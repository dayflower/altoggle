// The application icon and the version resource.
//
// NO MANIFEST BELONGS IN THIS FILE. build.rs embeds one through
// embed-manifest, and a second RT_MANIFEST resource produces an executable
// Windows refuses to start. Anything else is a matter of judgement; that one is
// not.
//
// Both resources below are per crate, not per target, so keylog, altprobe and
// imeprobe carry altoggle's icon and claim to be altoggle in their properties.
// Cargo offers no way to scope a resource, and only altoggle.exe is ever
// distributed.

// Id 1 is deliberate: the shell shows the icon with the lowest numeric id, so a
// lower one added later would silently take over.
//
// assets/appicon.ico is generated by `cargo run -p altoggle-icongen`.
1 ICON "assets/appicon.ico"

// What Explorer's Details tab, SmartScreen and any future winget or scoop
// manifest read. Without it the executable has no product name, no publisher
// and no version at all, which is most of the way to "unknown publisher".
//
// VS_VERSION_INFO is id 1 as well. That does not collide with the icon above:
// resource ids are scoped per resource type.
//
// The version is duplicated from Cargo.toml because rc.exe cannot read it. A
// test in crates/app/src/lib.rs asserts the two agree, so a forgotten bump
// fails `cargo test` rather than shipping quietly.
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "dayflower"
            VALUE "FileDescription", "Switches the IME from a solo press of a modifier key"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "altoggle"
            VALUE "LegalCopyright", "Copyright (c) 2026 dayflower. MIT licensed."
            VALUE "OriginalFilename", "altoggle.exe"
            VALUE "ProductName", "altoggle"
            VALUE "ProductVersion", "0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // US English, Unicode: the language of the strings above, not of the
        // machine running the binary.
        VALUE "Translation", 0x409, 1200
    END
END
